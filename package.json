{
  "name": "angular-rs-plugin",
  "description": "Rspack/Rsbuild plugin for Angular applications",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "",
    "postinstall": "node ./packages/angular-rspack-compiler/patch/patch-angular-build.js"
  },
  "files": [
    "dist",
    "patch",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@angular/compiler-cli": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/localize": "^22.1.1",
    "@angular/platform-server": "^22.1.1",
    "@angular/ssr": "^22.1.1",
    "@rsbuild/core": "^2.1.0",
    "tailwindcss": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "zone.js": "~0.15.0 || ~0.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
